{
  "_comment": "判据文件个数检查的红样本（判据文件）。CI 从 main 取这份样本和 main 上的 check-judgefiles.py，去测 PR 里那份脚本。改它要单开 PR，由所有者批。样本里的账号都是占位符，只有 Bosons-cyber 是所有者。",
  "rules": ["vocab.json", "scripts/", "tests/red/", ".github/workflows/"],
  "cases": [
    {"why": "不碰判据文件，通过", "pass": true, "action": "opened", "paths": ["README.md"]},
    {"why": "只碰一个判据文件，通过", "pass": true, "action": "synchronize", "paths": ["scripts/a.py", "README.md"]},
    {"why": "同一个文件写法不同只算一个", "pass": true, "action": "opened", "paths": ["vocab.json", "./vocab.json"]},
    {"why": "前缀相似但不在目录下，不能误配", "pass": true, "action": "opened", "paths": ["docs/scripts/a.py", "README.md"]},
    {"why": "大小写和反斜杠先统一再比，两个就报", "pass": false, "action": "opened", "paths": ["Scripts\\A.py", "Tests\\Red\\x.json"]},
    {"why": "改名时新旧路径都算", "pass": false, "action": "opened", "paths": [{"filename": "docs/x.py", "previous_filename": "scripts/x.py"}, {"filename": "vocab.json"}]},
    {"why": "两个判据文件、新开 PR，不通过", "pass": false, "action": "opened", "paths": ["vocab.json", "scripts/a.py"]},
    {"why": "两个判据文件、推了新提交，即使挂着标签也不通过", "pass": false, "action": "synchronize", "sender": "Bosons-cyber", "label": "multi-sensitive", "paths": ["vocab.json", "scripts/a.py"]},
    {"why": "所有者亲手加 multi-sensitive，通过", "pass": true, "action": "labeled", "sender": "Bosons-cyber", "label": "multi-sensitive", "paths": ["vocab.json", "scripts/a.py"]},
    {"why": "不是所有者加的标签，不通过", "pass": false, "action": "labeled", "sender": "other", "label": "multi-sensitive", "paths": ["vocab.json", "scripts/a.py"]},
    {"why": "所有者加的是别的标签，不通过", "pass": false, "action": "labeled", "sender": "Bosons-cyber", "label": "other", "paths": ["vocab.json", "scripts/a.py"]},
    {"why": "去掉标签，不通过", "pass": false, "action": "unlabeled", "sender": "Bosons-cyber", "label": "multi-sensitive", "paths": ["vocab.json", "scripts/a.py"]}
  ]
}
